# Servidor
PORT=3000
NODE_ENV=development

# Seguridad (obligatorio en producción / Vercel)
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria
LOGIN_RATE_LIMIT=10

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=tu_contraseña
MYSQL_DATABASE=carniceria
# En hospedajes remotos (Aiven, PlanetScale, Railway, etc.) normalmente se requiere SSL
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=false
MYSQL_CONNECTION_LIMIT=5
MYSQL_CONNECT_TIMEOUT=4000
# Si MySQL no responde, cuánto tiempo se usa el modo demostración antes de reintentar
MYSQL_RETRY_MS=60000

# MongoDB (Atlas recomendado para Vercel)
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/carniceria
USAR_TRANSACCIONES=false
MONGO_AUTO_INDEX=true

# Seed automático al iniciar el servidor local (en Vercel no aplica)
AUTO_SEED=true
